{% style %}
{{ section.settings.navigation_font | font_face: font_display: 'swap' }}
{% endstyle %}
<header class="jt-global-header" data-jt-navigation data-jt-area="store">
  <nav class="jt-global-bar" aria-label="{{ 'jt_navigation.navigation' | t | escape }}">
    <div class="jt-global-leading"><a class="jt-global-bag" href="{{ routes.cart_url }}" aria-label="{{ 'jt_navigation.bag' | t | escape }}"><svg viewBox="0 0 24 26" aria-hidden="true"><path d="M5 8h14l1 16H4L5 8Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>{% if cart.item_count > 0 %}<span class="jt-global-bag-count" aria-hidden="true">{{ cart.item_count }}</span>{% endif %}</a></div>
    <a class="jt-global-crest" href="https://jt-website-orpin.vercel.app/" aria-label="{{ 'jt_navigation.home' | t | escape }}"><img src="https://jt-website-orpin.vercel.app/images/jt-crest-transparent-v2.png" width="1254" height="1254" alt="{{ 'jt_navigation.logo' | t | escape }}"></a>
    <div class="jt-global-actions"><button class="jt-global-toggle" type="button" aria-label="{{ 'jt_navigation.open_menu' | t | escape }}" aria-expanded="false" aria-controls="jtGlobalMenu"><span></span><span></span></button></div>
  </nav>
</header>
<dialog class="jt-global-menu" id="jtGlobalMenu" aria-labelledby="jtGlobalMenuTitle">
  <h2 class="jt-global-sr" id="jtGlobalMenuTitle">{{ 'jt_navigation.explore' | t }}</h2>
  <div class="jt-global-menu-top"><div aria-hidden="true"></div><a class="jt-global-crest" href="https://jt-website-orpin.vercel.app/" aria-label="{{ 'jt_navigation.home' | t | escape }}"><img src="https://jt-website-orpin.vercel.app/images/jt-crest-transparent-v2.png" width="1254" height="1254" alt="{{ 'jt_navigation.logo' | t | escape }}"></a><button class="jt-global-close" type="button" aria-label="{{ 'jt_navigation.close_menu' | t | escape }}" autofocus><span aria-hidden="true"></span></button></div>
  <div class="jt-global-menu-inner">
    <nav class="jt-global-destinations" aria-label="{{ 'jt_navigation.explore' | t | escape }}">
      <a href="https://jt-website-orpin.vercel.app/" data-jt-area-link="website">{{ 'jt_navigation.coaching' | t }}</a>
      <a href="https://jt-website-orpin.vercel.app/performance-hub-portal.html" data-jt-area-link="hub">{{ 'jt_navigation.performance_hub' | t }}</a>
      <a href="{{ routes.root_url }}" data-jt-area-link="store">{{ 'jt_navigation.store' | t }}</a>
    </nav>
    <div class="jt-global-sections">
      <details name="jt-menu-sections" class="jt-global-section"><summary>{{ 'jt_navigation.store_tools' | t }}</summary><nav class="jt-global-store-tools" aria-label="{{ 'jt_navigation.store_tools' | t }}"><a href="{{ routes.search_url }}">{{ 'jt_navigation.search' | t }}</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'jt_navigation.account' | t }}</a>{% endif %}<a href="{{ routes.cart_url }}">{{ 'jt_navigation.bag' | t }}</a></nav></details>
      <details name="jt-menu-sections" class="jt-global-section" data-jt-tools hidden><summary>{{ 'jt_navigation.hub_tools' | t }}</summary><nav class="jt-global-tool-links" aria-label="{{ 'jt_navigation.hub_tools' | t | escape }}" data-jt-tool-links></nav></details>
      <details name="jt-menu-sections" class="jt-global-section"><summary>{{ 'jt_navigation.explore' | t }}</summary><nav class="jt-global-explore" aria-label="{{ 'jt_navigation.discover' | t | escape }}"><a href="https://jt-website-orpin.vercel.app/#pricing">{{ 'jt_navigation.book' | t }}</a><a href="https://jt-website-orpin.vercel.app/#pathway">{{ 'jt_navigation.pathway' | t }}</a><a href="https://jt-website-orpin.vercel.app/#team">{{ 'jt_navigation.coaches' | t }}</a><a href="https://jt-website-orpin.vercel.app/#reviews">{{ 'jt_navigation.reviews' | t }}</a><a href="https://jt-website-orpin.vercel.app/#about">{{ 'jt_navigation.about' | t }}</a><a href="https://jt-website-orpin.vercel.app/#findus">{{ 'jt_navigation.find' | t }}</a><a href="https://jt-website-orpin.vercel.app/#contact">{{ 'jt_navigation.contact' | t }}</a><a href="https://jt-website-orpin.vercel.app/performance-hub-coach-access.html">{{ 'jt_navigation.coach_login' | t }}</a></nav></details>
      <details name="jt-menu-sections" class="jt-global-section" data-jt-account-panel hidden><summary>{{ 'jt_navigation.account' | t }}</summary><div class="jt-global-account" data-jt-account></div></details>
    </div>
    <div class="jt-global-menu-footer"><p>{{ 'jt_navigation.tagline' | t }}</p><button class="jt-global-motion" type="button" data-jt-nav-motion data-pause-label="{{ 'jt_navigation.pause_animation' | t | escape }}" data-resume-label="{{ 'jt_navigation.resume_animation' | t | escape }}" aria-label="{{ 'jt_navigation.pause_animation' | t | escape }}" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path class="jt-global-pause" d="M7 5v10M13 5v10"/><path class="jt-global-play" d="m7 5 8 5-8 5Z"/></svg></button></div>
  </div>
  <div class="jt-global-ambient" aria-hidden="true"><i></i><i></i><i></i></div>
</dialog>

{% schema %}
{
  "name": "JT connected navigation",
  "tag": "section",
  "class": "jt-connected-navigation-section",
  "settings": [
    {
      "type": "font_picker",
      "id": "navigation_font",
      "label": "Navigation font",
      "default": "montserrat_n5"
    }
  ],
  "presets": [
    {
      "name": "JT connected navigation"
    }
  ]
}
{% endschema %}
