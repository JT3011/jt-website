{% style %}
{{ section.settings.navigation_font | font_face: font_display: 'swap' }}
{% endstyle %}
<header class="jt-global-header" data-jt-navigation data-jt-area="store">
  <nav class="jt-global-bar" aria-label="{{ 'jt_navigation.navigation' | t | escape }}">
    <div class="jt-global-left"><a href="https://jt-website-orpin.vercel.app/" data-jt-area-link="website">{{ 'jt_navigation.coaching' | t }}</a><a href="https://jt-website-orpin.vercel.app/performance-hub-portal.html" data-jt-area-link="hub"><span class="jt-global-long">{{ 'jt_navigation.performance' | t }}</span>{{ 'jt_navigation.hub' | t }}</a></div>
    <a class="jt-global-crest" href="https://jt-website-orpin.vercel.app/" aria-label="{{ 'jt_navigation.home' | t | escape }}"><img src="https://jt-website-orpin.vercel.app/images/jt-crest-transparent-v2.png" width="1254" height="1254" alt="{{ 'jt_navigation.logo' | t | escape }}"></a>
    <div class="jt-global-right"><a href="{{ routes.root_url }}" data-jt-area-link="store">{{ 'jt_navigation.store' | t }}</a><button class="jt-global-toggle" type="button" aria-label="{{ 'jt_navigation.open_menu' | t | escape }}" aria-expanded="false" aria-controls="jtGlobalMenu"><span></span><span></span></button></div>
  </nav>
  <nav class="jt-global-store-tools" aria-label="{{ 'jt_navigation.store_tools' | t }}"><a href="{{ routes.search_url }}">{{ 'jt_navigation.search' | t }}</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'jt_navigation.account' | t }}</a>{% endif %}<a href="{{ routes.cart_url }}">{{ 'jt_navigation.bag' | t }}</a></nav>
</header>
<dialog class="jt-global-menu" id="jtGlobalMenu" aria-labelledby="jtGlobalMenuTitle">
  <div class="jt-global-menu-top"><p id="jtGlobalMenuTitle">{{ 'jt_navigation.explore' | t }}</p><a class="jt-global-crest" href="https://jt-website-orpin.vercel.app/" aria-label="{{ 'jt_navigation.home' | t | escape }}"><img src="https://jt-website-orpin.vercel.app/images/jt-crest-transparent-v2.png" width="1254" height="1254" alt="{{ 'jt_navigation.logo' | t | escape }}"></a><button class="jt-global-close" type="button" aria-label="{{ 'jt_navigation.close_menu' | t | escape }}"><span aria-hidden="true">×</span></button></div>
  <div class="jt-global-menu-inner">
    <nav class="jt-global-destinations" aria-label="{{ 'jt_navigation.explore' | t | escape }}">
      <a href="https://jt-website-orpin.vercel.app/" data-jt-area-link="website"><span class="jt-global-number">01</span><span>{{ 'jt_navigation.coaching' | t }}</span><span class="jt-global-arrow" aria-hidden="true">↗</span></a>
      <a href="https://jt-website-orpin.vercel.app/performance-hub-portal.html" data-jt-area-link="hub"><span class="jt-global-number">02</span><span>{{ 'jt_navigation.performance_hub' | t }}</span><span class="jt-global-arrow" aria-hidden="true">↗</span></a>
      <a href="{{ routes.root_url }}" data-jt-area-link="store"><span class="jt-global-number">03</span><span>{{ 'jt_navigation.jt_store' | t }}</span><span class="jt-global-arrow" aria-hidden="true">↗</span></a>
    </nav>
    <div class="jt-global-tools" data-jt-tools hidden><p class="jt-global-eyebrow">{{ 'jt_navigation.your_hub' | t }}</p><nav class="jt-global-tool-links" aria-label="{{ 'jt_navigation.hub_tools' | t | escape }}" data-jt-tool-links></nav><div class="jt-global-account" data-jt-account></div></div>
    <nav class="jt-global-explore" aria-label="{{ 'jt_navigation.discover' | t | escape }}"><a href="https://jt-website-orpin.vercel.app/#pricing">{{ 'jt_navigation.book' | t }}</a><a href="https://jt-website-orpin.vercel.app/#pathway">{{ 'jt_navigation.pathway' | t }}</a><a href="https://jt-website-orpin.vercel.app/#team">{{ 'jt_navigation.coaches' | t }}</a><a href="https://jt-website-orpin.vercel.app/#reviews">{{ 'jt_navigation.reviews' | t }}</a><a href="https://jt-website-orpin.vercel.app/#about">{{ 'jt_navigation.about' | t }}</a><a href="https://jt-website-orpin.vercel.app/#findus">{{ 'jt_navigation.find' | t }}</a><a href="https://jt-website-orpin.vercel.app/#contact">{{ 'jt_navigation.contact' | t }}</a><a href="https://jt-website-orpin.vercel.app/performance-hub-coach-access.html">{{ 'jt_navigation.coach_login' | t }}</a></nav>
    <div class="jt-global-menu-footer"><p>{{ 'jt_navigation.tagline' | t }}</p><button type="button" data-jt-nav-motion data-pause-label="{{ 'jt_navigation.pause' | t | escape }}" data-resume-label="{{ 'jt_navigation.resume' | t | escape }}" aria-pressed="false">{{ 'jt_navigation.pause' | t }}</button></div>
  </div>
  <div class="jt-global-orbit" aria-hidden="true"><i></i><i></i></div>
</dialog>

{% schema %}
{
  "name": "JT connected navigation",
  "tag": "section",
  "class": "jt-connected-navigation-section",
  "settings": [
    {
      "type": "font_picker",
      "id": "navigation_font",
      "label": "Navigation font",
      "default": "montserrat_n5"
    }
  ],
  "presets": [
    {
      "name": "JT connected navigation"
    }
  ]
}
{% endschema %}
